kturen, State Management und API-Integrationen (REST, GraphQL). Erfahren sowohl in agiler Greenfield-Entwicklung als auch im Modernisieren komplexer Legacy-Codebases. Verbindet analytisches Denken aus dem Finanzsektor mit hohem Anspruch an Code-QualitÃ¤t und UX."}],"name":"","record":"SummarySection","showTitle":true},{"__t":"TechnologySection","column":1,"enabled":true,"height":34,"items":[{"height":216,"id":"agb2n1m3eo","record":"TechnologyItem","description":"","showTitle":true,"tags":["HTML","CSS","TypeScript","JavaScript","Tailwind CSS","React.js","Next.js","TanStack Query","TanStack Router","Zustand","Framer Motion","React Hook Form","Zod"],"title":"Frontend"},{"height":132,"id":"pe8aitnwwj","record":"TechnologyItem","description":"","showTitle":true,"tags":["Node.js","Express","SQLite","NestJS","REST APIs","Drizzle ORM","TypeORM","PostgreSQL","GraphQL"],"title":"Backend"},{"height":90,"id":"zezfgifful","record":"TechnologyItem","description":"","showTitle":true,"tags":["Docker","GitHub Actions","Vercel"],"title":"DevOps &amp;amp; CI/CD"},{"height":90,"id":"k5osh23cbm","record":"TechnologyItem","description":"","showTitle":true,"tags":["Agentic Coding","Claude Code","GitHub Copilot"],"title":"AI &amp;amp; Workflows"},{"height":132,"id":"033vng407n","record":"TechnologyItem","description":"","showTitle":true,"tags":["Git","Vite","npm","Bun","ESLint","Bitbucket","GitHub","Jest"],"title":"Tools &amp;amp; Testing"},{"height":132,"id":"xoot1j6i4e","record":"TechnologyItem","description":"","showTitle":true,"tags":["Component-based Architecture","Responsive Design","Scrum / Agile","Clean Code","Nx (Monorepo)"],"title":"Architektur &amp;amp; Arbeitsweise"}],"name":"","record":"TechnologySection","layoutMode":"tags","showBulletMarker":true,"surroundingBorder":true},{"__t":"LanguageSection","column":1,"enabled":true,"height":34,"items":[{"height":38,"id":"liuh60zqqz","record":"LanguageItem","level":5,"levelText":"Muttersprachler","name":"Deutsch"},{"height":38,"id":"jj